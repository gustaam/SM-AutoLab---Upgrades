# Regras de versionamento: mantém temporários, caches e artefatos fora do repositório.
# Python
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Build/package outputs
build/
dist/
*.spec
*.exe
*.zip
version_info.txt

# Runtime/local data
*.log
*.tmp
SM AutoLab/
checkpoint*.json
*_checkpoint*.json
feegow_config.json
.env

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
